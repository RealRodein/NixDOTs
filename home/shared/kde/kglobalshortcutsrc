# KGlobalAccel configuration (Plasma 6).
#
# Application launches are declared as "service" shortcuts keyed by the real XDG
# desktop id. kglobalacceld then launches the app straight from that .desktop
# file's Exec line, which means:
#   * no NoDisplay shim desktop files are needed (the app menu stays clean), and
#   * the shortcut, the task manager pin and the app grid always agree on one id.
#
# The `[services][<desktop id>]` form is what Plasma itself writes when a key is
# assigned in System Settings -> Keyboard Shortcuts -> Application Shortcuts.

[services][com.mitchellh.ghostty.desktop]
_launch=Meta+T

[services][nemo.desktop]
_launch=Meta+E

[services][org.kde.krunner.desktop]
_launch=Meta+R\tMeta+Space\tAlt+Space

[services][steam.desktop]
_launch=Meta+S

[services][vesktop.desktop]
_launch=Meta+D

[services][zen-beta.desktop]
_launch=Meta+W

[services][dev.zed.Zed.desktop]
_launch=Meta+C

# Screenshots, with the same semantics as the niri config:
#   Print        -> region,  Ctrl+Print -> whole screen,  Alt+Print -> active window
# Each one is a NoDisplay service that runs Spectacle with the matching flag.
[services][kde-screenshot-region.desktop]
_launch=Print

[services][kde-screenshot-screen.desktop]
_launch=Ctrl+Print

[services][kde-screenshot-window.desktop]
_launch=Alt+Print

[kwin]
# niri parity: Meta+Q closes the focused window, Meta+Ctrl+F toggles fullscreen.
# (Alt+F4 / Meta+PgUp / Meta+PgDown keep working as secondary bindings.)
Window Close=Meta+Q\tAlt+F4,Alt+F4,Close Window
Window Fullscreen=Meta+Ctrl+F,,Toggle Window Fullscreen
# Free the Meta+<letter> keys claimed by the app shortcuts above; without this
# KWin's defaults would swallow Meta+T, Meta+D and Meta+W first.
Edit Tiles=none,Meta+T,Toggle Tiles Editing
Overview=none,Meta+W,Toggle the Overview
Show Desktop=none,Meta+D,Show Desktop

[plasmashell]
# Super still opens the launcher (Plasma default), Meta+R is niri's launcher key.
activate application launcher=Meta,Meta\tAlt+F1,Activate Application Launcher
# Meta+Q is "close window" now, not "switch activity".
manage activities=none,Meta+Q,Switch to the Activity Switcher
